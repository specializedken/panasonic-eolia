      "browser_pkce": {
        "title": "Log in to your Panasonic account",
        "description": "1. Open this link in any browser: {authorize_url}\n2. Log in with your Panasonic ID (the same account the Eolia app uses).\n3. The page will fail to load after you log in -- **this is expected**, ignore any error shown.\n4. Open your browser's Developer Tools (F12 on Windows/Linux, Cmd+Option+I on Mac) and switch to the **Network** tab.\n5. Find the request whose Name starts with `panasonic-eolia:` and click it.\n6. Copy the full **Request URL** shown in the right-hand panel (it contains `code=...`).\n7. Paste that whole URL below.",
        "data": {
          "authorization_response": "Pasted URL (or just the code)"
        }
      },
      "paste_refresh_token": {
        "title": "Enter a refresh token",
